# ===========================================
# SWIFT Converter - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# For production, set these in Northflank dashboard

# ===== Backend URL =====
BACKEND_URL=https://your-backend-app.northflank.app

# ===== Database =====
# Provide the full JDBC URL from Neon
DATABASE_URL=jdbc:postgresql://ep-xxx.us-east-2.aws.neon.tech/dbname?user=dbuser&password=dbpassword&sslmode=require

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379

# ===== JWT =====
JWT_SECRET=your-256-bit-secret-key-here-make-it-long-enough-for-hs256-min-32-chars

# ===== Frontend URL =====
FRONTEND_URL=https://www.swiftmxbridge.com

# ===== Google OAuth =====
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ===== Lemon Squeezy =====
LEMON_SQUEEZY_API_KEY=ls_your-api-key
LEMON_SQUEEZY_WEBHOOK_SECRET=your-webhook-signing-secret
LEMON_SQUEEZY_STORE_ID=your-store-id
LEMON_SQUEEZY_VARIANT_STARTER=your-starter-variant-id
LEMON_SQUEEZY_VARIANT_PRO=your-professional-variant-id
LEMON_SQUEEZY_VARIANT_ENTERPRISE=your-enterprise-variant-id

# ===== Environment =====
SPRING_PROFILES_ACTIVE=prod

# ===== Email Configuration - Resend =====
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your-api-key-here
# This must be a verified domain in your Resend account
RESEND_FROM_EMAIL=support@yourdomain.com

# ===== Support Email =====
SUPPORT_EMAIL=support@yourdomain.com

# ===== Logging =====
LOG_LEVEL=INFO
